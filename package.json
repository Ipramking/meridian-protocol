{
  "name": "meridian-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-chain capital router for Stellar: CCTP fast-fills, allowlisted USDC vaults, KYC gating and SEP-24 off-ramp",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run contracts:test && npm run test --workspace=@meridian-protocol/sdk",
    "contracts:build": "cargo build --target wasm32v1-none --release",
    "contracts:test": "cargo build --target wasm32v1-none --release && cargo test --workspace --lib",
    "deploy:testnet": "node scripts/deploy.mjs --network testnet",
    "e2e:testnet": "node scripts/e2e-testnet.mjs",
    "seed:issues": "node issues/seed-issues.js"
  },
  "keywords": [
    "stellar",
    "soroban",
    "rwa",
    "cross-chain",
    "cctp",
    "dex",
    "intent-routing"
  ],
  "author": "Ipramking <inioluwasamuel.13pram@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0"
  }
}
